# Copy to clinics/<clinic>/.env and fill in. The .env file is gitignored — never commit it.
# Check it with:  python -m core.check_env        (add --live to test each key against the vendor)
#
# Generate random secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# development | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Backend --------------------------------------------------------------
# Local run against the compose Postgres. Inside docker-compose this is overridden
# to point at the `postgres` service.
# No Docker? Use a local SQLite file instead (development only, refused in production):
#   DATABASE_URL=sqlite+aiosqlite:///var/dev.db
DATABASE_URL=postgresql+asyncpg://receptionist:receptionist@localhost:5432/receptionist
# >= 32 chars, signs dashboard session cookies
SESSION_SECRET=
# >= 24 chars, shared secret the agent uses to call the backend
AGENT_API_TOKEN=
BACKEND_URL=http://localhost:8000
# allowed CORS / WebSocket origin
DASHBOARD_ORIGIN=http://localhost:3000

# --- LiveKit Cloud (cloud.livekit.io -> Settings -> Keys) -----------------
# wss://<project>.livekit.cloud
LIVEKIT_URL=
# starts with API
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Speech ---------------------------------------------------------------
# console.deepgram.com -> API Keys
DEEPGRAM_API_KEY=
# play.cartesia.ai -> API Keys (voice ID goes in clinic.yaml)
# Cartesia: required only when clinic.yaml voice.tts_provider is "cartesia" (the production default).
# The voice test caller (tests/scenarios/voice_call.py) also uses it for the caller's own voice.
# CARTESIA_API_KEY=
# Kokoro (self-hosted, voice.tts_provider: kokoro): the `kokoro` service in deploy/docker-compose.yml.
# Inside docker compose the agent is pointed at http://kokoro:8880/v1 automatically.
KOKORO_BASE_URL=http://localhost:8880/v1
# Used when clinic.yaml has no voice.voice_id
KOKORO_VOICE=af_heart

# --- LLM (any OpenAI-compatible endpoint; keep the model at 7B–14B) -------
# Groq (timed tests; free tier 8,000 tokens/min, so space test calls out). It serves no 7-14B Qwen
#   today; qwen3.8-27b measured 0.29 s to first token. The warm-up only spends rate limit there:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=qwen/qwen3.8-27b
#   LLM_EXTRA_BODY={"reasoning_effort":"none"}
#   LLM_WARMUP=false
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1   e.g. LLM_MODEL=qwen/qwen3.5-9b
# Ollama (local, free). Recommended: Qwen3 8B. Build it once with
#   ollama pull qwen3:8b  and  ollama create qwen3-clinic -f Modelfile.qwen3
#   then swap these lines in (any key works). Use 127.0.0.1, not localhost: on Windows,
#   localhost tries IPv6 first and adds ~2 s to every request. Ollama ignores /no_think, so
#   reasoning_effort is what turns Qwen3 thinking off (otherwise 2-6 s per reply).
#   The Docker agent reaches it via host.docker.internal automatically.
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=qwen3-clinic
#   LLM_EXTRA_BODY={"reasoning_effort":"none"}
#   Measured 2026-11-09 on an RTX 5050 laptop: qwen3-clinic 22/22 text scenarios, multi-step
#   flows 8/8, ~0.3 s to first token. qwen-clinic (qwen2.5:7b, ./Modelfile, needs
#   LLM_DISABLE_THINKING=false) is faster (~0.2 s) but completes multi-step flows only ~half the time.
# The agent has the LLM read the system prompt while the greeting plays, so the first reply is
# fast (one extra short request per call). Turn off with LLM_WARMUP=false.
# Check the provider's model list for the exact Qwen model ID it serves today.
# Measured 2026-11-09 from India: qwen3.5-9b ~0.5 s to first token; qwen3-14b ~0.9-1.7 s, and
# one of its two OpenRouter hosts doesn't support tool calls.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3.5-9b
# Optional JSON merged into every request. On OpenRouter: prefer the hosts that measured fastest; others are a fallback (hosts without tool support
# are skipped automatically), and turn reasoning off (it adds seconds to every reply).
LLM_EXTRA_BODY={"provider":{"order":["Together","DeepInfra"]},"reasoning":{"enabled":false}}

# --- Twilio (number + SIP trunk come in Phase 2) -------------------------
# AC...
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# +1403..., only needed for NOTIFY_CHANNEL=twilio_sms
TWILIO_FROM_NUMBER=

# --- Staff notifications --------------------------------------------------
# log = print to the backend console (development only)
# log | sendgrid | smtp | twilio_sms
NOTIFY_CHANNEL=log
NOTIFY_FROM_EMAIL=
# SG....
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

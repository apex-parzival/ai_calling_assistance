# Copy to clinics/<clinic>/.env and fill in. The .env file is gitignored — never commit it.
# Check it with:  python -m core.check_env        (add --live to test each key against the vendor)
#
# Generate random secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO

# --- Backend --------------------------------------------------------------
# Local run against the compose Postgres. Inside docker-compose this is overridden
# to point at the `postgres` service.
# No Docker? Use a local SQLite file instead (development only, refused in production):
#   DATABASE_URL=sqlite+aiosqlite:///var/dev.db
DATABASE_URL=postgresql+asyncpg://receptionist:receptionist@localhost:5432/receptionist
SESSION_SECRET=                  # >= 32 chars, signs dashboard session cookies
AGENT_API_TOKEN=                 # >= 24 chars, shared secret the agent uses to call the backend
BACKEND_URL=http://localhost:8000
DASHBOARD_ORIGIN=http://localhost:3000   # allowed CORS / WebSocket origin

# --- LiveKit Cloud (cloud.livekit.io -> Settings -> Keys) -----------------
LIVEKIT_URL=                     # wss://<project>.livekit.cloud
LIVEKIT_API_KEY=                 # starts with API
LIVEKIT_API_SECRET=

# --- Speech ---------------------------------------------------------------
DEEPGRAM_API_KEY=                # console.deepgram.com -> API Keys
CARTESIA_API_KEY=                # play.cartesia.ai -> API Keys (voice ID goes in clinic.yaml)

# --- LLM (any OpenAI-compatible endpoint; keep the model at 7B–14B) -------
# Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1   e.g. LLM_MODEL=qwen/qwen3-14b
# Check the provider's model list for the exact Qwen model ID it serves today.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3-14b

# --- Twilio (number + SIP trunk come in Phase 2) -------------------------
TWILIO_ACCOUNT_SID=              # AC...
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=              # +1403..., only needed for NOTIFY_CHANNEL=twilio_sms

# --- Staff notifications --------------------------------------------------
# log = print to the backend console (development only)
NOTIFY_CHANNEL=log               # log | sendgrid | smtp | twilio_sms
NOTIFY_FROM_EMAIL=
SENDGRID_API_KEY=                # SG....
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
